# Meltano Core Configuration
MELTANO_PROJECT_ROOT=/path/to/your/qs-finances
MELTANO_ENVIRONMENT=dev

# dbt Configuration
DBT_DUCKDB_PATH=/path/to/your/qs-finances/data/catalog/qsmds.duckdb

# AWS S3 Access (required for financial data sources)
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_DEFAULT_REGION=us-east-1

# BTG Pactual Configuration (for encrypted files)
TAP_BTG_FILE_PASSWORD=your-btg-file-password-here

# Optional: Custom S3 bucket (default: felippe-data)
# S3_BUCKET_NAME=your-custom-bucket-name

# Optional: Production environment settings
# MELTANO_ENVIRONMENT=prod